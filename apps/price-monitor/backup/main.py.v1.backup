# main_v2.py의 전체 내용을 붙여넣기
from flask import Flask, request, jsonify
from datetime import datetime
import requests
import os
import sys
import traceback
import pytz

# 모든 import를 최상단에 모음
from scrapers.moyo_scraper import MoyoScraper
from core.firebase_handler import FirebaseHandler
from core.comparator import Comparator

app = Flask(__name__)

# 환경변수
BOT_TOKEN = os.getenv('TELEGRAM_BOT_TOKEN', '')
CHAT_ID = os.getenv('TELEGRAM_CHAT_ID', '')
KOREA_TZ = pytz.timezone('Asia/Seoul')

# 로깅 설정
def log(message):
    """로그 출력"""
    timestamp = datetime.now(KOREA_TZ).strftime('%Y-%m-%d %H:%M:%S')
    print(f"[{timestamp}] {message}")

def get_korea_time():
    """한국 시간 반환"""
    return datetime.now(KOREA_TZ)

def send_telegram(text):
    """텔레그램 메시지 전송"""
    log("📤 텔레그램 전송 시도...")
    
    if not BOT_TOKEN or not CHAT_ID:
        log("⚠️ 텔레그램 설정 없음 (TELEGRAM_BOT_TOKEN 또는 TELEGRAM_CHAT_ID)")
        return False
    
    url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
    data = {
        "chat_id": CHAT_ID,
        "text": text
    }
    try:
        response = requests.post(url, json=data, timeout=10)
        if response.status_code == 200:
            log("✅ 텔레그램 전송 성공!")
            return True
        else:
            log(f"❌ 텔레그램 전송 실패: {response.status_code} - {response.text}")
            return False
    except Exception as e:
        log(f"❌ 텔레그램 전송 에러: {e}")
        return False

# ============================================================
# 최신 분석 함수들
# ============================================================

def get_latest_plans_analysis():
    """Firestore에서 최신 데이터를 로드해 분석"""
    db = FirebaseHandler()
    latest = db.get_latest_data('moyo')
    
    if not latest:
        return None
    
    plans = latest.get('plans', [])
    checked_at = latest.get('checked_at')
    
    # 한국 시간으로 변환
    if hasattr(checked_at, 'astimezone'):
        korea_time = checked_at.astimezone(KOREA_TZ)
    else:
        korea_time = get_korea_time()
    
    return {
        'checked_at': korea_time,
        'total_plans': len(plans),
        'plans': plans
    }

def get_best_value_plans(plans, limit=3):
    """가성비 최고 요금제"""
    scored = []
    for p in plans:
        if p.get('data_gb', 0) > 0 and p.get('final_price', 0) > 0:
            value = p['data_gb'] / p['final_price']
            scored.append({
                'plan': p,
                'value': value,
                'price_per_gb': p['final_price'] / p['data_gb']
            })
    
    top = sorted(scored, key=lambda x: x['value'], reverse=True)[:limit]
    return top

def get_popular_plans(plans, limit=3):
    """인기 요금제 (가입자 수)"""
    with_subs = [p for p in plans if p.get('subscribers', 0) > 0]
    top = sorted(with_subs, key=lambda x: x['subscribers'], reverse=True)[:limit]
    return top

def get_cheapest_plans(plans, limit=3):
    """최저가 요금제"""
    top = sorted(plans, key=lambda x: x.get('final_price', float('inf')))[:limit]
    return top

@app.route('/')
def index():
    """Health check"""
    return jsonify({
        "status": "ok",
        "service": "Price Monitor",
        "version": "2.0",
        "timestamp": datetime.now(KOREA_TZ).isoformat()
    })

@app.route('/check-moyo', methods=['POST'])
def check_moyo():
    """
    모요 체크 (Cloud Scheduler가 호출)
    
    Flow:
    1. MoyoScraper로 2,300개 요금제 수집
    2. FirebaseHandler로 Firestore에 저장
    3. Comparator로 경쟁력 분석 및 알림 생성
    4. Telegram으로 결과 전송
    """
    try:
        log("🚀 모요 체크 시작")
        
        # ==========================================
        # 1️⃣ 스크래핑
        # ==========================================
        log("1️⃣ MoyoScraper 시작...")
        scraper = MoyoScraper()
        plans, screenshot = scraper.scrape()
        log(f"   ✅ {len(plans)}개 요금제 수집 완료")
        
        if not plans:
            error_msg = "❌ 모요 스크래핑 실패: 요금제를 찾지 못함"
            log(error_msg)
            send_telegram(error_msg)
            return jsonify({
                "status": "error",
                "error": "No plans found",
                "timestamp": datetime.now(KOREA_TZ).isoformat()
            }), 500
        
        # ==========================================
        # 2️⃣ Firebase 저장
        # ==========================================
        log("2️⃣ Firebase 저장...")
        db = FirebaseHandler()
        save_success = db.save_check_result('moyo', plans, screenshot)
        
        if not save_success:
            error_msg = "⚠️ Firebase 저장 실패 (계속 진행)"
            log(error_msg)
        else:
            log("   ✅ Firestore 저장 완료")
        
        # ==========================================
        # 3️⃣ 비교 분석
        # ==========================================
        log("3️⃣ 경쟁력 분석...")
        try:
            comparator = Comparator()
            alerts = comparator.analyze_competitiveness(plans)
            log(f"   ✅ {len(alerts)}개 알림 생성")
        except Exception as e:
            log(f"   ⚠️ 경쟁력 분석 실패: {e}")
            alerts = []
        
        # ==========================================
        # 4️⃣ 결과 메시지 생성 (개선된 포맷)
        # ==========================================
        log("4️⃣ 메시지 생성...")
        
        korea_time = get_korea_time()
        message = f"""📊 MVNO 요금제 모니터링 완료

⏰ 수집 시간 (한국): {korea_time.strftime('%Y-%m-%d %H:%M:%S')}
📈 수집: {len(plans)}개 요금제
🚨 알림: {len(alerts)}개

"""
        
        # 알림이 있으면 상세 표시
        if alerts:
            message += "⚠️ 주요 알림:\n"
            for i, alert in enumerate(alerts[:5], 1):
                message += f"\n{i}. {alert['message']}"
            
            if len(alerts) > 5:
                message += f"\n\n... 외 {len(alerts) - 5}개 알림"
        else:
            message += "✅ 경쟁력 양호! 특이사항 없음"
        
        # 상위 요금제 정보
        message += "\n\n" + "="*40
        message += "\n📌 인기 상위 3개 요금제:\n"
        
        for i, plan in enumerate(plans[:3], 1):
            name = plan['name'][:30]  # 길이 제한
            message += f"\n{i}. {plan['display_name']}"
            message += f"\n   {name}"
            message += f"\n   💰 {plan['final_price']:,}원"
            if plan.get('subscribers', 0) > 0:
                message += f" | 👥 {plan['subscribers']:,}명"
            message += "\n"
        
        log(f"   ✅ 메시지 생성: {len(message)} 글자")
        
        # ==========================================
        # 5️⃣ Telegram 전송
        # ==========================================
        log("5️⃣ Telegram 전송...")
        send_telegram(message)
        
        # ==========================================
        # ✅ 완료
        # ==========================================
        log(f"✅ 모요 체크 완료")
        
        return jsonify({
            "status": "success",
            "plans_count": len(plans),
            "alerts_count": len(alerts),
            "timestamp": datetime.now(KOREA_TZ).isoformat(),
            "message": "Check completed successfully"
        })
    
    except Exception as e:
        error_traceback = traceback.format_exc()
        log(f"❌ 모요 체크 실패: {str(e)}")
        log(f"상세 에러:\n{error_traceback}")
        
        error_msg = f"""❌ 모요 체크 실패

⏰ 시간 (한국): {get_korea_time().strftime('%Y-%m-%d %H:%M:%S')}
🔴 에러: {str(e)}

📋 로그를 확인하세요.
"""
        send_telegram(error_msg)
        
        return jsonify({
            "status": "error",
            "error": str(e),
            "timestamp": datetime.now(KOREA_TZ).isoformat()
        }), 500

# ============================================================
# 새로운 엔드포인트: 최신 분석 (스크래핑 없이 빠른 응답)
# ============================================================

@app.route('/latest-analysis', methods=['GET'])
def latest_analysis():
    """
    최신 데이터 기반 분석 (DB 활용, 빠른 응답)
    
    응답: {
        "status": "ok",
        "checked_at": "2026-02-10 05:09:29 KST",
        "total_plans": 2322,
        "best_value": [...],
        "popular": [...],
        "cheapest": [...]
    }
    """
    try:
        log("📊 최신 분석 요청 (DB 활용)")
        
        analysis = get_latest_plans_analysis()
        
        if not analysis:
            return jsonify({
                "status": "no_data",
                "message": "저장된 데이터가 없습니다",
                "timestamp": datetime.now(KOREA_TZ).isoformat()
            }), 404
        
        plans = analysis['plans']
        checked_at = analysis['checked_at']
        
        # 각 카테고리별 분석
        best_value = get_best_value_plans(plans, 3)
        popular = get_popular_plans(plans, 3)
        cheapest = get_cheapest_plans(plans, 3)
        
        # 응답 포맷
        response = {
            "status": "ok",
            "timestamp": datetime.now(KOREA_TZ).isoformat(),
            "checked_at_korea": checked_at.strftime('%Y-%m-%d %H:%M:%S %Z'),
            "total_plans": analysis['total_plans'],
            "best_value_plans": [
                {
                    "name": p['plan']['display_name'],
                    "data_gb": p['plan']['data_gb'],
                    "price": p['plan']['final_price'],
                    "subscribers": p['plan']['subscribers'],
                    "value_score": round(p['value'], 2),
                    "price_per_gb": round(p['price_per_gb'], 0)
                }
                for p in best_value
            ],
            "popular_plans": [
                {
                    "name": p['display_name'],
                    "data": p['data'],
                    "price": p['final_price'],
                    "subscribers": p['subscribers']
                }
                for p in popular
            ],
            "cheapest_plans": [
                {
                    "name": p['display_name'],
                    "data": p['data'],
                    "price": p['final_price'],
                    "subscribers": p['subscribers']
                }
                for p in cheapest
            ]
        }
        
        log("✅ 최신 분석 완료 (즉시 응답)")
        return jsonify(response)
    
    except Exception as e:
        log(f"❌ 최신 분석 실패: {e}")
        return jsonify({
            "status": "error",
            "error": str(e),
            "timestamp": datetime.now(KOREA_TZ).isoformat()
        }), 500

@app.route('/latest-analysis/message', methods=['GET'])
def latest_analysis_message():
    """
    최신 분석을 Telegram 포맷으로 반환
    """
    try:
        log("📤 최신 분석 메시지 생성")
        
        analysis = get_latest_plans_analysis()
        
        if not analysis:
            return jsonify({
                "status": "no_data",
                "message": "저장된 데이터가 없습니다"
            }), 404
        
        plans = analysis['plans']
        checked_at = analysis['checked_at']
        
        # 분석 데이터
        best_value = get_best_value_plans(plans, 3)
        popular = get_popular_plans(plans, 3)
        cheapest = get_cheapest_plans(plans, 3)
        
        # 메시지 포맷
        message = f"""📊 MVNO 요금제 최신 분석

⏰ 수집 시간: {checked_at.strftime('%Y-%m-%d %H:%M:%S %Z')}
📈 총 요금제: {len(plans):,}개

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

🏆 가성비 최고 요금제:

"""
        for i, item in enumerate(best_value, 1):
            p = item['plan']
            message += f"{i}. {p['display_name']}\n"
            message += f"   📊 {p['data']} | 💰 {p['final_price']:,}원\n"
            message += f"   ⭐ 가성비: {item['value']:.2f} | GB당: {item['price_per_gb']:.0f}원\n"
            message += f"   👥 {p['subscribers']:,}명\n\n"
        
        message += """━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

🔥 인기 요금제:

"""
        for i, p in enumerate(popular, 1):
            message += f"{i}. {p['display_name']}\n"
            message += f"   📊 {p['data']} | 💰 {p['final_price']:,}원\n"
            message += f"   👥 {p['subscribers']:,}명\n\n"
        
        message += """━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

💵 최저가 요금제:

"""
        for i, p in enumerate(cheapest, 1):
            message += f"{i}. {p['display_name']}\n"
            message += f"   💰 {p['final_price']:,}원 | 📊 {p['data']}\n\n"
        
        return jsonify({
            "status": "ok",
            "message": message,
            "checked_at_korea": checked_at.strftime('%Y-%m-%d %H:%M:%S %Z'),
            "timestamp": datetime.now(KOREA_TZ).isoformat()
        })
    
    except Exception as e:
        log(f"❌ 메시지 생성 실패: {e}")
        return jsonify({
            "status": "error",
            "error": str(e)
        }), 500

@app.route('/status')
def status():
    """
    상태 확인 엔드포인트
    최근 수집 정보 조회
    """
    try:
        db = FirebaseHandler()
        latest = db.get_latest_data('moyo')
        
        if latest:
            checked_at = latest.get('checked_at')
            if hasattr(checked_at, 'astimezone'):
                korea_time = checked_at.astimezone(KOREA_TZ)
            else:
                korea_time = get_korea_time()
            
            return jsonify({
                "status": "ok",
                "service": "Price Monitor",
                "last_check_korea": korea_time.strftime('%Y-%m-%d %H:%M:%S %Z'),
                "last_plan_count": latest.get('plan_count'),
                "timestamp": datetime.now(KOREA_TZ).isoformat()
            })
        else:
            return jsonify({
                "status": "no_data",
                "message": "No check result yet",
                "timestamp": datetime.now(KOREA_TZ).isoformat()
            })
    except Exception as e:
        return jsonify({
            "status": "error",
            "error": str(e),
            "timestamp": datetime.now(KOREA_TZ).isoformat()
        }), 500

@app.errorhandler(404)
def not_found(error):
    """404 에러 핸들러"""
    return jsonify({
        "status": "error",
        "error": "Not Found",
        "message": "This endpoint does not exist",
        "timestamp": datetime.now(KOREA_TZ).isoformat()
    }), 404

@app.errorhandler(500)
def server_error(error):
    """500 에러 핸들러"""
    return jsonify({
        "status": "error",
        "error": "Internal Server Error",
        "timestamp": datetime.now(KOREA_TZ).isoformat()
    }), 500

if __name__ == '__main__':
    port = int(os.getenv('PORT', 8080))
    debug = os.getenv('FLASK_DEBUG', 'False').lower() == 'true'
    
    log(f"🚀 Flask 앱 시작")
    log(f"   포트: {port}")
    log(f"   디버그: {debug}")
    log(f"   시간대: {KOREA_TZ}")
    log(f"   Telegram 설정: {'✅' if BOT_TOKEN and CHAT_ID else '❌'}")
    
    app.run(
        host='0.0.0.0',
        port=port,
        debug=debug
    )