# ── 텔레그램 ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
TELEGRAM_WEBHOOK_URL=https://your-service-xxxxx-an.a.run.app

# 내 텔레그램 user_id (쉼표로 여러 명 가능)
# @userinfobot 에 /start 보내면 확인 가능
ALLOWED_USER_IDS=123456789

# ── Gmail ─────────────────────────────────────────────────
GMAIL_ADDRESS=yourname@gmail.com

# Gmail 앱 비밀번호 설정 방법:
# Google 계정 → 보안 → 2단계 인증 활성화
# → 앱 비밀번호 → 기타(직접 입력) → 생성
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── 사내 메일 ──────────────────────────────────────────────
OFFICE_MAIL=yourname@company.com
